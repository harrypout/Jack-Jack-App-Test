# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # flutter_reactive_ble's bundled bledata.pb.swift calls
  # `SwiftProtobuf._NameMap(bytecode:)`. That initializer FIRST appears in
  # SwiftProtobuf 1.31.0 — 1.30.0 and earlier only have `_NameMap()` /
  # `_NameMap(reservedNames:...)`, so against them the build fails with
  # "argument passed to call that takes no arguments" (apple/swift-protobuf#1830).
  # So SwiftProtobuf must be >= 1.31.0.
  #
  # But every version that has `init(bytecode:)` (>= 1.31.0) also ships
  # BytecodeReader.swift / BytecodeInterpreter.swift using Swift's `package`
  # access level, which fails to compile under CocoaPods because CocoaPods does
  # not pass `-package-name` ("the package access level used on 'BytecodeReader'
  # requires a package name"; apple/swift-protobuf#1334). There is no version
  # that both has the initializer AND avoids the package-access files, so the
  # `-package-name` flag is injected for the SwiftProtobuf target in the
  # post_install hook below. Pin to 1.31.0 for a reproducible resolve that
  # matches the bytecode format reactive_ble's generated code was built against.
  pod 'SwiftProtobuf', '1.31.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # SwiftProtobuf >= 1.31.0 uses Swift's `package` access level in its
    # bytecode decoder, which requires the `-package-name` compiler flag.
    # CocoaPods doesn't pass one, so inject it for this target (the value is
    # an arbitrary package identifier). Without this, SwiftProtobuf fails to
    # build and reactive_ble then can't find `_NameMap(bytecode:)`.
    if target.name == 'SwiftProtobuf'
      target.build_configurations.each do |config|
        config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -package-name swiftprotobuf'
      end
    end

    target.build_configurations.each do |config|
      # Xcode 16's "Explicitly Built Modules" fails to compile SwiftProtobuf's
      # `package`-access code during a Release archive ("cannot find type
      # 'Message'/'_NameMap'/... in scope"). `flutter build ipa` does not use
      # explicit modules, which is why the same code compiles fine there.
      # Disable explicit modules for the pods so a manual Xcode archive matches.
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

      # permission_handler: only compile in the permissions this app uses.
      # Without these macros every handler (location, contacts, camera, ...)
      # is included, which risks App Store rejection for unused permission
      # APIs. This app only requests Bluetooth and Notifications.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',

        ## dart: PermissionGroup.calendar (legacy)
        'PERMISSION_EVENTS=0',

        ## dart: PermissionGroup.calendarFullAccess
        'PERMISSION_EVENTS_FULL_ACCESS=0',

        ## dart: PermissionGroup.reminders
        'PERMISSION_REMINDERS=0',

        ## dart: PermissionGroup.contacts
        'PERMISSION_CONTACTS=0',

        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=0',

        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=0',

        ## dart: PermissionGroup.speech
        'PERMISSION_SPEECH_RECOGNIZER=0',

        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=0',

        ## dart: [PermissionGroup.location, locationAlways, locationWhenInUse]
        'PERMISSION_LOCATION=0',

        ## dart: PermissionGroup.notification
        'PERMISSION_NOTIFICATIONS=1',

        ## dart: PermissionGroup.mediaLibrary
        'PERMISSION_MEDIA_LIBRARY=0',

        ## dart: PermissionGroup.sensors
        'PERMISSION_SENSORS=0',

        ## dart: PermissionGroup.bluetooth
        'PERMISSION_BLUETOOTH=1',

        ## dart: PermissionGroup.appTrackingTransparency
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',

        ## dart: PermissionGroup.criticalAlerts
        'PERMISSION_CRITICAL_ALERTS=0',

        ## dart: PermissionGroup.assistant
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end
end
